---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import Analytics from '../components/Analytics.astro';
import { site } from '../config/site.ts';
import { organizationJsonLd } from '../data/seo.ts';

interface Props {
  /** Titre SEO complet (unique par page). */
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  /** Masque le bouton WhatsApp flottant (ex. page de devis, administration). */
  hideFab?: boolean;
  /** Message WhatsApp contextuel du bouton flottant. */
  whatsappMessage?: string;
  /** Mise en page minimale (administration). */
  bare?: boolean;
}

const {
  title,
  description,
  image = '/images/og-geometre-topo.jpg',
  imageAlt = 'Géomètre Topo – géomètre topographe à Yaoundé',
  noindex = false,
  ogType = 'website',
  jsonLd = [],
  hideFab = false,
  whatsappMessage,
  bare = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const structured = noindex ? [] : [organizationJsonLd(Astro.site!), ...jsonLd];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#01005d" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {site.googleSiteVerification && <meta name="google-site-verification" content={site.googleSiteVerification} />}

    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    {structured.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    {!bare && <Header />}
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    {!bare && <Footer />}
    {!bare && !hideFab && <WhatsAppFab message={whatsappMessage} />}
    {!bare && <Analytics />}
  </body>
</html>
