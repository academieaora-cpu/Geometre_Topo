---
import Icon from './Icon.astro';
import { nav, site, whatsappLink, defaultWhatsappMessage } from '../config/site.ts';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? current === '/' : current === href || current.startsWith(href + '/'));
const wa = whatsappLink(defaultWhatsappMessage);
---
<div class="topbar">
  <div class="container topbar-inner">
    <ul>
      {site.phoneHref && <li><Icon name="phone" size={15} /><a href={site.phoneHref} data-track="click_phone" data-track-location="topbar">{site.phone}</a></li>}
      {site.email && <li class="hide-sm"><Icon name="mail" size={15} /><a href={`mailto:${site.email}`} data-track="click_email" data-track-location="topbar">{site.email}</a></li>}
      <li><Icon name="pin" size={15} /><span>Yaoundé et environs</span></li>
    </ul>
    {wa && (
      <a class="topbar-wa" href={wa} target="_blank" rel="noopener" data-track="click_whatsapp" data-track-location="topbar">
        <Icon name="whatsapp" size={16} /> WhatsApp
      </a>
    )}
  </div>
</div>
<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${site.name} – accueil`}>
      <span class="logo-badge"><img src="/images/logo-96.webp" srcset="/images/logo-96.webp 1x, /images/logo-192.webp 2x" width="77" height="48" alt="" /></span>
      <span class="brand-text"><strong>Géomètre Topo</strong><small>Géomètre topographe · Yaoundé</small></span>
    </a>

    <nav class="nav-desktop" aria-label="Navigation principale">
      <ul>
        {nav.slice(1).map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      {site.phoneHref && (
        <a class="call" href={site.phoneHref} data-track="click_phone" data-track-location="header" aria-label={`Appeler ${site.phone}`}>
          <Icon name="phone" size={20} />
        </a>
      )}
      <a class="btn btn--primary cta" href="/devis" data-track="cta_devis" data-track-location="header">Demander un devis</a>

      <details class="nav-mobile">
        <summary aria-label="Ouvrir le menu"><Icon name="menu" size={26} /><span class="sr-only">Menu</span></summary>
        <nav aria-label="Navigation mobile">
          <ul>
            {nav.map((item) => (
              <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
            ))}
            <li><a href="/devis" class="btn btn--primary btn--block" data-track="cta_devis" data-track-location="menu">Demander un devis</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .topbar { background: var(--navy-800); color: #d5dbeb; font-size: .82rem; }
  .topbar-inner { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 38px; }
  .topbar ul { display: flex; flex-wrap: wrap; gap: 6px 22px; list-style: none; margin: 0; padding: 0; }
  .topbar li { display: flex; align-items: center; gap: 7px; margin: 0; }
  .topbar :global(svg) { color: var(--green-500); }
  .topbar a { color: #e9edf7; text-decoration: none; }
  .topbar a:hover { color: var(--white); text-decoration: underline; }
  .topbar-wa { display: inline-flex; align-items: center; gap: 6px; background: var(--whatsapp); color: var(--white) !important; padding: 4px 12px; border-radius: 999px; font-weight: 600; }
  .topbar-wa:hover { text-decoration: none !important; background: var(--whatsapp-dark); }
  @media (max-width: 640px) { .hide-sm { display: none !important; } .topbar-wa { display: none; } }

  .site-header {
    position: sticky; top: 0; z-index: 50; background: rgb(255 255 255 / 96%);
    backdrop-filter: saturate(160%) blur(8px); border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; gap: 16px; min-height: var(--header-h); }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; flex: none; }
  .logo-badge { display: grid; place-items: center; background: var(--navy-900); border-radius: 8px; padding: 4px 8px; }
  .logo-badge img { height: 40px; width: auto; }
  .brand-text { display: none; line-height: 1.15; }
  .brand-text strong { display: block; font-family: var(--font-head); font-size: 1.05rem; color: var(--navy-800); font-weight: 800; }
  .brand-text small { font-size: .78rem; color: var(--muted); }
  @media (min-width: 1240px) { .brand-text { display: block; } }

  .nav-desktop { display: none; margin-left: auto; }
  .nav-desktop ul { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .nav-desktop li { margin: 0; }
  .nav-desktop a {
    display: block; padding: 10px 13px; color: var(--navy-800); text-decoration: none;
    font-family: var(--font-head); font-weight: 600; font-size: .95rem; border-radius: 6px;
  }
  .nav-desktop a:hover { color: var(--green-700); background: var(--green-100); }
  .nav-desktop a[aria-current='page'] { color: var(--green-700); box-shadow: inset 0 -2px 0 var(--green-500); border-radius: 0; }
  @media (min-width: 1000px) { .nav-desktop { display: block; } }

  .actions { display: flex; align-items: center; gap: 8px; margin-left: auto; }
  @media (min-width: 1000px) { .actions { margin-left: 8px; } }
  .call {
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 8px;
    color: var(--navy-800); border: 1px solid var(--line);
  }
  .call:hover { border-color: var(--green-500); color: var(--green-700); }
  .cta { min-height: 44px; padding: 8px 16px; font-size: .93rem; }
  @media (max-width: 420px) { .cta { display: none; } }

  .nav-mobile { position: static; }
  .nav-mobile summary {
    list-style: none; cursor: pointer; display: grid; place-items: center; width: 44px; height: 44px;
    border-radius: 8px; border: 1px solid var(--line); color: var(--navy-800);
  }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .nav-mobile nav {
    position: absolute; left: 0; right: 0; top: 100%; background: var(--white);
    border-top: 1px solid var(--line); padding: 8px var(--gutter) 20px; box-shadow: var(--shadow-lg);
    max-height: calc(100dvh - var(--header-h)); overflow-y: auto;
  }
  .nav-mobile ul { list-style: none; margin: 0; padding: 0; }
  .nav-mobile li { margin: 0; }
  .nav-mobile a:not(.btn) {
    display: block; padding: 14px 4px; color: var(--navy-800); text-decoration: none;
    font-family: var(--font-head); font-weight: 600; font-size: 1.1rem; border-bottom: 1px solid var(--line);
  }
  .nav-mobile a[aria-current='page'] { color: var(--green-700); }
  .nav-mobile .btn { margin-top: 16px; }
  @media (min-width: 1000px) { .nav-mobile { display: none; } }
</style>
