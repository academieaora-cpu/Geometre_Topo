---
/**
 * Contact rapide toujours visible : bouton WhatsApp flottant sur ordinateur,
 * barre « Appeler / WhatsApp / Devis » fixée en bas de l'écran sur mobile.
 */
import Icon from './Icon.astro';
import { defaultWhatsappMessage, site, whatsappLink } from '../config/site.ts';

interface Props { message?: string }
const href = whatsappLink(Astro.props.message ?? defaultWhatsappMessage);
---
{href && (
  <a class="wa-fab" href={href} aria-label="Écrire sur WhatsApp" target="_blank" rel="noopener" data-track="click_whatsapp" data-track-location="bouton_flottant">
    <Icon name="whatsapp" size={28} />
    <span>WhatsApp</span>
  </a>
)}
{(href || site.phoneHref) && (
  <nav class="mobile-bar" aria-label="Contact rapide">
    {site.phoneHref && (
      <a class="mb-call" href={site.phoneHref} data-track="click_phone" data-track-location="barre_mobile"><Icon name="phone" size={20} />Appeler</a>
    )}
    {href && (
      <a class="mb-wa" href={href} target="_blank" rel="noopener" data-track="click_whatsapp" data-track-location="barre_mobile"><Icon name="whatsapp" size={20} />WhatsApp</a>
    )}
    <a class="mb-devis" href="/devis" data-track="cta_devis" data-track-location="barre_mobile"><Icon name="file" size={20} />Devis</a>
  </nav>
)}

<style>
  .wa-fab {
    position: fixed; right: 16px; bottom: 16px; z-index: 40;
    display: inline-flex; align-items: center; gap: 8px; min-height: 56px; padding: 0 18px 0 14px;
    background: var(--whatsapp); color: var(--white); border-radius: 999px; text-decoration: none; font-weight: 700;
    box-shadow: 0 6px 20px rgb(0 0 0 / 25%);
  }
  .wa-fab:hover { background: var(--whatsapp-dark); color: var(--white); }
  .mobile-bar { display: none; }
  @media (max-width: 760px) {
    .wa-fab { display: none; }
    .mobile-bar {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
      display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 8px;
      padding: 8px 12px calc(8px + env(safe-area-inset-bottom));
      background: rgb(255 255 255 / 97%); border-top: 1px solid var(--line); box-shadow: 0 -6px 20px rgb(10 28 74 / 10%);
    }
    .mobile-bar a {
      display: flex; align-items: center; justify-content: center; gap: 6px; min-height: 48px;
      border-radius: var(--radius); font-weight: 700; text-decoration: none; font-size: .95rem;
    }
    .mb-call { border: 1.5px solid var(--navy-800); color: var(--navy-800); background: var(--white); }
    .mb-wa { background: var(--whatsapp); color: var(--white); }
    .mb-devis { background: var(--navy-800); color: var(--white); }
    .mobile-bar a:hover { color: inherit; }
    .mb-wa:hover, .mb-devis:hover { color: var(--white); }
  }
  @media print { .wa-fab, .mobile-bar { display: none; } }
</style>
