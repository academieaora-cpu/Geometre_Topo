---
/**
 * Contact rapide toujours visible : boutons ronds flottants en bas à droite.
 * Mobile : Devis, Appeler et WhatsApp ; ordinateur : WhatsApp seul (l'en-tête porte déjà l'appel et le devis).
 * Seul le bouton WhatsApp bat légèrement pour attirer l'attention (désactivé si le visiteur limite les animations).
 */
import Icon from './Icon.astro';
import { defaultWhatsappMessage, site, whatsappLink } from '../config/site.ts';

interface Props { message?: string }
const href = whatsappLink(Astro.props.message ?? defaultWhatsappMessage);
---
{(href || site.phoneHref) && (
  <nav class="fab-stack" aria-label="Contact rapide">
    <a class="fab fab--devis" href="/devis" aria-label="Demander un devis" title="Demander un devis" data-track="cta_devis" data-track-location="bouton_flottant">
      <Icon name="file" size={24} />
    </a>
    {site.phoneHref && (
      <a class="fab fab--call" href={site.phoneHref} aria-label={`Appeler le ${site.phone}`} title="Appeler" data-track="click_phone" data-track-location="bouton_flottant">
        <Icon name="phone" size={24} />
      </a>
    )}
    {href && (
      <a class="fab fab--wa" href={href} target="_blank" rel="noopener" aria-label="Écrire sur WhatsApp" title="WhatsApp" data-track="click_whatsapp" data-track-location="bouton_flottant">
        <Icon name="whatsapp" size={32} />
      </a>
    )}
  </nav>
)}

<style>
  .fab-stack {
    position: fixed; right: 16px; bottom: calc(16px + env(safe-area-inset-bottom)); z-index: 40;
    display: flex; flex-direction: column; align-items: center; gap: 12px;
  }
  .fab {
    display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%;
    text-decoration: none; box-shadow: 0 6px 18px rgb(10 28 74 / 25%); transition: transform .15s ease;
  }
  .fab:hover { transform: scale(1.06); }
  .fab--devis, .fab--devis:hover { background: var(--navy-800); color: var(--white); }
  .fab--call, .fab--call:hover { background: var(--white); color: var(--navy-800); border: 2px solid var(--navy-800); }
  .fab--wa, .fab--wa:hover { background: var(--whatsapp); color: var(--white); }
  .fab--wa { position: relative; isolation: isolate; width: 60px; height: 60px; animation: wa-beat 2.6s ease-in-out infinite; }
  /* Onde qui s'élargit autour du bouton, au rythme du battement. */
  .fab--wa::before {
    content: ''; position: absolute; inset: 0; z-index: -1; border-radius: 50%;
    background: var(--whatsapp); animation: wa-ring 2.6s ease-out infinite;
  }
  @keyframes wa-beat {
    0%, 40%, 100% { transform: scale(1); }
    10% { transform: scale(1.08); }
    20% { transform: scale(1); }
    30% { transform: scale(1.05); }
  }
  @keyframes wa-ring {
    0% { transform: scale(1); opacity: .5; }
    60%, 100% { transform: scale(1.65); opacity: 0; }
  }
  @media (min-width: 761px) { .fab--devis, .fab--call { display: none; } }
  @media print { .fab-stack { display: none; } }
</style>
