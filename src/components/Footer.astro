---
import ContactLinks from './ContactLinks.astro';
import Icon from './Icon.astro';
import { site, socialProfiles } from '../config/site.ts';
import { activeServices } from '../data/services.ts';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container cols">
    <div>
      <img src="/images/logo-96.webp" width="77" height="48" alt="Géomètre Topo" loading="lazy" />
      <p class="about">
        {site.owner}, géomètre topographe. Levés, bornes, implantations et accompagnement de vos projets fonciers à Yaoundé et dans ses environs.
      </p>
      {socialProfiles.length > 0 && (
        <ul class="socials" aria-label="Réseaux sociaux">
          {socialProfiles.map((s) => (
            <li><a href={s.url} target="_blank" rel="noopener me" aria-label={`${site.name} sur ${s.label}`} data-track="click_social" data-track-location={s.label}><Icon name={s.icon} size={20} /></a></li>
          ))}
        </ul>
      )}
    </div>
    <div>
      <h2>Services</h2>
      <ul>
        {activeServices.slice(0, 7).map((s) => <li><a href={`/services/${s.slug}`}>{s.name}</a></li>)}
        <li><a href="/services">Tous les services</a></li>
      </ul>
    </div>
    <div>
      <h2>Le site</h2>
      <ul>
        <li><a href="/a-propos">À propos</a></li>
        <li><a href="/realisations">Réalisations</a></li>
        <li><a href="/conseils">Conseils</a></li>
        <li><a href="/devis">Demande de devis</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/#abonnement">Recevoir nos conseils</a></li>
      </ul>
    </div>
    <div>
      <h2>Contact</h2>
      <ContactLinks variant="list" location="footer" />
    </div>
  </div>
  <div class="container legal">
    <p>© {year} {site.name}. Tous droits réservés.</p>
    <ul>
      <li><a href="/mentions-legales">Mentions légales</a></li>
      <li><a href="/confidentialite">Confidentialité</a></li>
      <li><a href="/confidentialite#cookies">Cookies</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer { background: var(--navy-800); border-top: 4px solid var(--green-500); color: #c8cfe3; padding-top: 56px; font-size: .95rem; }
  .cols { display: grid; gap: 32px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); padding-bottom: 32px; }
  .about { margin-top: 14px; }
  h2 { color: var(--white); font-size: .85rem; text-transform: uppercase; letter-spacing: .14em; margin-bottom: 16px; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { margin: 0 0 8px; }
  a { color: #e6eaf5; text-decoration: none; }
  a:hover { color: var(--white); text-decoration: underline; }
  .legal {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding-block: 20px 96px;
    border-top: 1px solid rgb(255 255 255 / 12%); font-size: .88rem;
  }
  .socials { display: flex; gap: 10px; margin-top: 18px; }
  .socials li { margin: 0; }
  .socials a { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 10px; border: 1px solid rgb(255 255 255 / 20%); color: var(--white); }
  .socials a:hover { background: var(--green-700); border-color: var(--green-700); text-decoration: none; }
  .legal p { margin: 0; }
  .legal ul { display: flex; flex-wrap: wrap; gap: 16px; }
  .legal li { margin: 0; }
</style>
