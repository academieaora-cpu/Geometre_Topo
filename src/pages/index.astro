---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ContactLinks from '../components/ContactLinks.astro';
import Faq from '../components/Faq.astro';
import LeadForm from '../components/LeadForm.astro';
import SubscribeBox from '../components/SubscribeBox.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import PhotoMarquee from '../components/PhotoMarquee.astro';
import { activeServices } from '../data/services.ts';
import { communesVoisines, site, socialProfiles, yaoundeQuartiers } from '../config/site.ts';
import { homeFaq } from '../data/faq.ts';
import { websiteJsonLd } from '../data/seo.ts';

const featured = activeServices.filter((s) =>
  ['leve-topographique', 'bornage-recherche-de-bornes', 'morcellement-de-terrain', 'implantation-batiment', 'plan-topographique', 'dossier-technique-immatriculation'].includes(s.slug),
);

const strengths = [
  { icon: 'target', title: 'Mesures précises', text: 'Récepteur GNSS et station totale, contrôlés avant chaque remise.' },
  { icon: 'chat', title: 'Explications claires', text: 'Vous comprenez ce qui a été mesuré et ce qu’il reste à faire.' },
  { icon: 'shield', title: 'Données confidentielles', text: 'Vos documents fonciers ne sont jamais publiés ni partagés.' },
  { icon: 'file', title: 'Devis avant intervention', text: 'Un prix clair, adapté à votre terrain, avant tout déplacement.' },
];

const problems = [
  { icon: 'search', title: 'Des limites incertaines', text: 'Vous ne savez pas exactement où s’arrête votre terrain, ou une clôture voisine vous semble mal placée.', href: '/services/bornage-recherche-de-bornes' },
  { icon: 'marker', title: 'Des bornes introuvables', text: 'Les bornes ont disparu sous la végétation, ont été arrachées ou n’ont jamais été retrouvées.', href: '/services/bornage-recherche-de-bornes' },
  { icon: 'split', title: 'Un terrain à morceler', text: 'Vente d’une partie, partage familial ou création de lots : le découpage doit être juste et réalisable.', href: '/services/morcellement-de-terrain' },
  { icon: 'building', title: 'Une construction à préparer', text: 'Avant de construire, il faut connaître le terrain et implanter le bâtiment au bon endroit.', href: '/services/implantation-batiment' },
];

const steps = [
  { title: 'Vous décrivez votre besoin', text: 'Par le formulaire, WhatsApp ou téléphone, avec les documents dont vous disposez.' },
  { title: 'Nous étudions la situation', text: 'Nous identifions les travaux utiles et vous envoyons un devis clair.' },
  { title: 'Intervention sur le terrain', text: 'Mesures au récepteur GNSS et/ou à la station totale, à la date convenue.' },
  { title: 'Remise des résultats', text: 'Plans, constats ou repères implantés, avec des explications compréhensibles.' },
];

// Photos de terrain sans le visage du géomètre (son portrait n'apparaît que dans la présentation).
const heroSlides: [string, string, string, string, string, string] = [
  'recepteur-gnss-mur-enduit', 'station-gnss-angle-parcelle', 'pose-borne-beton',
  'releve-gnss-regard-assainissement', 'recepteur-gnss-cour-terre-rouge', 'recepteur-gnss-mur-parpaings',
];
const marquee = [
  'bornes-beton-parcelle', 'implantation-prisme-mur', 'canne-gnss-bipied-controleur', 'jalons-borne-existante',
  'pose-canalisation-tranchee', 'borne-peinte-limite', 'extrait-plan-parcelle', 'jalons-bipied-chantier',
  'gnss-vegetation-dense', 'bornes-beton-avant-pose', 'traitement-plans-ordinateur', 'borne-terrain-humide',
  'recepteur-gnss-trepied', 'tranchee-chantier-assainissement',
];
---
<BaseLayout
  title="Géomètre topographe à Yaoundé – Levés, bornage, implantation | Géomètre Topo"
  description={site.description}
  jsonLd={[websiteJsonLd(Astro.site!)]}
>
  <!-- Accueil -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <h1>
          <span class="eyebrow h1-kicker">Géomètre topographe à Yaoundé</span>
          Votre terrain mérite une <span class="hl-box">mesure précise.</span>
        </h1>
        <p class="lead">
          Vous avez un terrain à sécuriser ou un projet de construction à préparer ? Géomètre Topo, votre géomètre à
          Yaoundé et dans ses environs, s’occupe du levé topographique, des bornes, du morcellement, du dossier technique
          d’immatriculation et de l’implantation.
        </p>
        <ContactLinks location="hero" />
        <ul class="hero-facts">
          <li><strong>ENSTP</strong><span>géomètre diplômé</span></li>
          <li><strong>GNSS</strong><span>et station totale</span></li>
          <li><strong>Devis</strong><span>avant intervention</span></li>
        </ul>
      </div>
      <div class="hero-media">
        <HeroSlideshow slugs={heroSlides} />
        <div class="trust-card">
          <span class="s-icon"><Icon name="shield" size={20} /></span>
          <div><strong>Géomètre diplômé de l’ENSTP</strong><span>Yaoundé et ses environs</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Points forts -->
  <section class="strengths" aria-label="Nos engagements">
    <div class="container strengths-grid">
      {strengths.map((s) => (
        <div class="strength">
          <span class="s-icon"><Icon name={s.icon} size={22} /></span>
          <div><h2 class="h3">{s.title}</h2><p>{s.text}</p></div>
        </div>
      ))}
    </div>
  </section>

  <!-- Message -->
  <section class="section statement-wrap">
    <div class="container">
      <p class="statement">
        Avant d’<span class="hl">acheter</span>, de <span class="hl">construire</span> ou de{' '}
        <span class="hl">partager</span> un terrain, une mesure précise vous évite bien des litiges.
      </p>
    </div>
  </section>

  <!-- Prestations -->
  <section class="section section--surface" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Prestations</p>
        <h2 id="services-title">Des travaux topographiques <span class="hl">adaptés à votre terrain</span></h2>
        <p>Particuliers, familles, promoteurs ou entreprises du BTP : chaque intervention commence par la compréhension de votre besoin.</p>
      </div>
      <div class="grid grid--3">
        {featured.map((s) => <ServiceCard service={s} />)}
      </div>
      <p class="center more-link"><a class="btn btn--outline" href="/services">Voir toutes les prestations</a></p>
    </div>
  </section>

  <!-- Situations fréquentes -->
  <section class="section" aria-labelledby="problems-title">
    <div class="container two-col two-col--center">
      <div>
        <p class="eyebrow">Situations fréquentes</p>
        <h2 id="problems-title">Vous vous reconnaissez <span class="hl">dans l’une de ces situations ?</span></h2>
        <p class="lead">Ce sont les problèmes que nous rencontrons le plus souvent chez les propriétaires de Yaoundé et des environs.</p>
        <div class="problem-list">
          {problems.map((p) => (
            <a class="problem" href={p.href}>
              <span class="icon-badge"><Icon name={p.icon} /></span>
              <span><strong>{p.title}</strong><span class="muted">{p.text}</span></span>
              <Icon name="arrow" size={20} class="arrow" />
            </a>
          ))}
        </div>
      </div>
      <Photo slug="releve-gnss-borne" sizes="(min-width: 900px) 45vw, 90vw" ratio="4 / 5" class="tall-photo" />
    </div>
  </section>

  <!-- Réalisations -->
  <section class="section section--grid" aria-labelledby="work-title">
    <div class="container work-head">
      <div class="video-card">
        <video
          data-work-video
          muted
          loop
          playsinline
          preload="none"
          poster="/videos/releve-gnss-chantier-poster.webp"
          width="540"
          height="960"
          aria-label="Vidéo : récepteur GNSS installé sur un chantier pour un relevé topographique"
        >
          <source src="/videos/releve-gnss-chantier.mp4" type="video/mp4" />
        </video>
        <span class="video-label"><Icon name="target" size={16} /> Relevé GNSS sur chantier</span>
      </div>
      <div>
        <p class="eyebrow">Sur le terrain</p>
        <h2 id="work-title">Nos interventions, <span class="hl">en photos et en vidéo</span></h2>
        <p class="lead">
          Des images authentiques de nos descentes : relevés GNSS, station totale, pose et recherche de bornes, plans et
          chantiers. Par respect pour nos clients, aucune localisation ni donnée foncière n’est publiée.
        </p>
        <div class="btn-row">
          <a class="btn btn--outline" href="/realisations">Voir toutes les photos</a>
        </div>
        {socialProfiles.length > 0 && (
          <p class="follow">
            Suivez nos chantiers :
            {socialProfiles.map((s) => (
              <a href={s.url} target="_blank" rel="noopener me" data-track="click_social" data-track-location="accueil_terrain"><Icon name={s.icon} size={18} />{s.label}</a>
            ))}
          </p>
        )}
      </div>
    </div>
    <PhotoMarquee slugs={marquee} label="Photos de nos interventions (défilement automatique, s’arrête au survol)" />
  </section>

  <!-- Présentation -->
  <section class="section" aria-labelledby="about-title">
    <div class="container two-col two-col--center about">
      <Photo slug="portrait-alain-stephane-olouou" sizes="(min-width: 900px) 40vw, 90vw" class="portrait" />
      <div>
        <p class="eyebrow">Votre interlocuteur</p>
        <h2 id="about-title">{site.owner}, <span class="hl">géomètre topographe</span></h2>
        <blockquote class="quote">Des mesures fiables et des explications claires, pour décider en connaissance de cause.</blockquote>
        <p>
          Derrière Géomètre Topo, il y a une équipe de terrain dirigée par un géomètre topographe diplômé de l’École
          nationale supérieure des travaux publics (ENSTP) de Yaoundé. Nous nous déplaçons sur votre parcelle, nous prenons
          le temps de comprendre votre situation et nous vous expliquons les résultats en termes simples.
        </p>
        <ul class="chips">
          <li>Levés topographiques</li><li>Bornes et limites</li><li>Implantation</li><li>Nivellement</li>
        </ul>
        <div class="btn-row">
          <a class="btn btn--primary" href="/devis" data-track="cta_devis" data-track-location="presentation">Prendre rendez-vous</a>
          <a class="btn btn--outline" href="/a-propos">Découvrir notre approche</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Processus -->
  <section class="section section--surface" aria-labelledby="process-title">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Comment ça se passe</p>
        <h2 id="process-title">Nous vous accompagnons <span class="hl">à chaque étape</span></h2>
      </div>
      <ol class="steps steps--row">
        {steps.map((s) => <li><h3>{s.title}</h3><p>{s.text}</p></li>)}
      </ol>
    </div>
  </section>

  <!-- FAQ + zone -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container two-col two-col--wide-left">
      <div>
        <p class="eyebrow">Questions fréquentes</p>
        <h2 id="faq-title">Vos questions, <span class="hl">nos réponses</span></h2>
        <Faq items={homeFaq} />
      </div>
      <aside class="zone">
        <Photo slug="station-totale-mise-en-station" alt="" sizes="(min-width: 900px) 35vw, 90vw" ratio="16 / 10" />
        <div class="zone-body">
          <h2 class="h3">Votre géomètre à Yaoundé</h2>
          <p>Nous intervenons dans tous les arrondissements de <strong>Yaoundé</strong> (Yaoundé I à VII) : {yaoundeQuartiers.join(', ')}…</p>
          <p class="muted small">Communes voisines ({communesVoisines.join(', ')}…) ou terrain plus éloigné ? Indiquez sa localité dans votre demande : nous vous confirmons la possibilité d’intervention.</p>
          <a href="/contact" class="link-arrow">Nous contacter <Icon name="arrow" size={18} /></a>
        </div>
      </aside>
    </div>
  </section>

  <!-- Formulaire -->
  <section class="section" aria-labelledby="formulaire-title">
    <div class="container two-col">
      <div>
        <p class="eyebrow">Demande de devis</p>
        <h2 id="formulaire-title">Faites <span class="hl">étudier votre projet</span></h2>
        <p class="lead">Décrivez votre terrain et votre besoin. Vous serez recontacté par le moyen de votre choix.</p>
        <ul class="check-list">
          <li>Une réponse adaptée à votre situation réelle</li>
          <li>Un devis clair avant toute intervention</li>
          <li>Aucun document sensible demandé au premier contact</li>
        </ul>
        <Photo slug="materiel-gnss-terrain" alt="" sizes="(min-width: 900px) 40vw, 90vw" ratio="16 / 10" class="form-photo" />
      </div>
      <LeadForm id="formulaire" />
    </div>
  </section>

  <!-- Abonnement (après le formulaire : il ne lui fait pas concurrence) -->
  <section class="section section--grid">
    <div class="container"><SubscribeBox /></div>
  </section>
</BaseLayout>

<script>
  // La vidéo ne se charge et ne joue que lorsqu'elle est à l'écran, et jamais si le visiteur
  // a demandé à limiter les animations ou activé l'économie de données.
  const video = document.querySelector<HTMLVideoElement>('[data-work-video]');
  const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (video && !reduce && !conn?.saveData && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        video.preload = 'auto';
        video.play().catch(() => { /* lecture automatique refusée : l'affiche reste visible */ });
      } else {
        video.pause();
      }
    }, { threshold: 0.3 }).observe(video);
  }
</script>

<style>
  .hero {
    padding-block: clamp(32px, 6vw, 80px) clamp(40px, 6vw, 72px);
    background:
      radial-gradient(1200px 500px at 85% 10%, rgb(74 208 111 / 10%), transparent 60%),
      linear-gradient(rgb(10 28 74 / 3.5%) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(90deg, rgb(10 28 74 / 3.5%) 1px, transparent 1px) 0 0 / 48px 48px,
      var(--white);
  }
  .hero-grid { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 960px) { .hero-grid { grid-template-columns: 1.15fr 1fr; gap: 56px; } }
  .hero .lead { margin-bottom: 28px; max-width: 56ch; }
  .h1-kicker { display: flex; letter-spacing: .14em; margin-bottom: 1.2em; }
  .hero-facts { list-style: none; padding: 24px 0 0; margin: 32px 0 0; display: flex; flex-wrap: wrap; gap: 16px 40px; border-top: 1px solid var(--line); }
  .hero-facts li { margin: 0; display: flex; flex-direction: column; }
  .hero-facts strong { font-family: var(--font-head); font-size: 1.5rem; font-weight: 800; color: var(--green-700); line-height: 1.1; }
  .hero-facts span { color: var(--muted); font-size: .92rem; }

  .hero-media { position: relative; max-width: 440px; width: 100%; justify-self: center; }
  .trust-card {
    position: absolute; left: -28px; top: 28px; display: flex; align-items: center; gap: 12px; max-width: 270px;
    background: var(--white); padding: 10px 16px 10px 10px; border-radius: 14px; box-shadow: var(--shadow-lg);
    border: 1px solid var(--line);
  }
  .trust-card strong { display: block; font-family: var(--font-head); color: var(--navy-800); font-size: .92rem; line-height: 1.25; }
  .trust-card span:not(.s-icon) { font-size: .82rem; color: var(--muted); }
  @media (max-width: 600px) { .trust-card { left: 8px; top: 10px; } .hero-media { max-width: 360px; } }

  .work-head { display: grid; gap: 32px; align-items: center; margin-bottom: 40px; }
  @media (min-width: 860px) { .work-head { grid-template-columns: minmax(0, 340px) 1fr; gap: 56px; } }
  .video-card { position: relative; border-radius: 22px; overflow: hidden; box-shadow: var(--shadow-lg); aspect-ratio: 9 / 14; background: var(--surface); max-width: 340px; width: 100%; justify-self: center; }
  .video-card video { width: 100%; height: 100%; object-fit: cover; }
  .video-label {
    position: absolute; left: 16px; bottom: 16px; display: inline-flex; align-items: center; gap: 8px;
    background: rgb(255 255 255 / 92%); color: var(--navy-800); padding: 8px 14px; border-radius: 999px;
    font-family: var(--font-head); font-weight: 700; font-size: .88rem;
  }
  .video-label :global(svg) { color: var(--green-700); }
  .follow { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px; margin-top: 20px; color: var(--muted); font-size: .95rem; }
  .follow a { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; }

  .strengths { border-block: 1px solid var(--line); background: var(--white); }
  .strengths-grid { display: grid; gap: 4px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); padding-block: 28px; }
  .strength { display: flex; gap: 14px; padding: 12px 8px; }
  .s-icon { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 10px; background: var(--green-100); color: var(--green-700); flex: none; }
  .strength h2 { font-size: 1rem; margin: 2px 0 4px; }
  .strength p { margin: 0; color: var(--muted); font-size: .92rem; line-height: 1.5; }

  .statement-wrap { padding-block: clamp(48px, 7vw, 88px); }
  .statement {
    font-family: var(--font-head); font-weight: 800; color: var(--navy-800); text-align: center;
    font-size: clamp(1.5rem, 3.6vw, 2.6rem); line-height: 1.2; letter-spacing: -0.02em; max-width: 26ch; margin: 0 auto;
  }

  .more-link { margin-top: 36px; }

  .problem-list { display: grid; gap: 12px; margin-top: 24px; }
  .problem {
    display: flex; align-items: center; gap: 16px; padding: 16px 18px; border: 1px solid var(--line); border-radius: var(--radius-lg);
    background: var(--white); text-decoration: none; color: var(--ink); transition: border-color .15s, box-shadow .15s;
  }
  .problem:hover { border-color: var(--green-500); box-shadow: var(--shadow); color: var(--ink); }
  .problem :global(.icon-badge) { margin: 0; flex: none; }
  .problem strong { display: block; font-family: var(--font-head); color: var(--navy-800); }
  .problem .muted { font-size: .92rem; line-height: 1.5; display: block; }
  .problem :global(.arrow) { margin-left: auto; color: var(--green-700); flex: none; }
  .tall-photo { max-width: 520px; width: 100%; justify-self: center; }

  @media (max-width: 600px) { .hero :global(.btn-row .btn) { flex: 1 1 100%; } }

  .about :global(.portrait img) { aspect-ratio: 1 / 1; object-position: center 22%; max-width: 480px; margin-inline: auto; }
  .quote { margin: 0 0 18px; padding: 4px 0 4px 18px; border-left: 3px solid var(--green-500); font-size: 1.1rem; color: var(--navy-800); }
  .chips { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; margin: 20px 0 24px; }
  .chips li { margin: 0; background: var(--surface); border: 1px solid var(--line); padding: 8px 14px; border-radius: 8px; font-family: var(--font-head); font-weight: 600; font-size: .9rem; color: var(--navy-800); }

  .zone { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow); }
  .zone :global(img) { border-radius: 0; }
  .zone-body { padding: 22px 24px 26px; }
  .zone h2 { font-size: 1.3rem; }

  .form-photo { margin-top: 28px; }
  /* Sur mobile, le formulaire remonte : la photo d'illustration est masquée. */
  @media (max-width: 860px) { .form-photo { display: none; } }
</style>
