---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminConfigured, currentAdmin } from '../../server/auth.ts';

export const prerender = false;

if (currentAdmin(Astro.cookies)) return Astro.redirect('/admin');

const messages: Record<string, string> = {
  identifiants: 'Identifiants incorrects.',
  bloque: 'Trop de tentatives échouées. Réessayez dans 15 minutes.',
  configuration: 'L’administration n’est pas encore configurée (variables ADMIN_EMAIL, ADMIN_PASSWORD_HASH, SESSION_SECRET).',
  technique: 'Connexion impossible pour le moment (base de données indisponible ?).',
  origine: 'Requête refusée.',
};
const error = messages[Astro.url.searchParams.get('erreur') ?? ''];
const configured = adminConfigured();
---
<AdminLayout title="Connexion">
  <div class="login card">
    <h1 class="h2">Espace d’administration</h1>
    {!configured && <p class="notice">{messages.configuration}</p>}
    {error && <p class="alert" role="alert">{error}</p>}
    <form method="post" action="/api/admin/login">
      <label for="email">E-mail</label>
      <input id="email" name="email" type="email" autocomplete="username" required />
      <label for="password">Mot de passe</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required />
      <button class="btn btn--primary btn--block" type="submit">Se connecter</button>
    </form>
  </div>
</AdminLayout>

<style>
  .login { max-width: 420px; margin: 40px auto; }
  .login h1 { font-size: 1.5rem; }
  label { display: block; font-weight: 600; margin: 14px 0 6px; }
  input { width: 100%; min-height: 48px; padding: 10px 12px; font: inherit; font-size: 16px; border: 1.5px solid #b9bccb; border-radius: var(--radius); }
  button { margin-top: 20px; }
  .alert { background: var(--danger-100); color: var(--danger); padding: 10px 14px; border-radius: var(--radius); font-weight: 600; }
</style>
