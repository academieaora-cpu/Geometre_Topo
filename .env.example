# Copier ce fichier en .env pour le développement local (ne JAMAIS committer .env).
# En production, saisir ces valeurs dans Vercel > Project > Settings > Environment Variables.

# --- Site public (valeurs publiques, intégrées au site à la compilation) ---
SITE_URL=https://www.exemple-domaine.cm
PUBLIC_PHONE=+237 6XX XX XX XX
# Numéro WhatsApp au format international, chiffres uniquement. Vide = déduit de PUBLIC_PHONE.
PUBLIC_WHATSAPP_NUMBER=2376XXXXXXXX
PUBLIC_EMAIL=contact@exemple-domaine.cm
# Facultatif
PUBLIC_HOURS=
PUBLIC_SOCIAL_LINKS=
PUBLIC_GA_ID=
PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Secrets serveur (ne jamais préfixer par PUBLIC_) ---
# Supabase : Project Settings > Database > Connection string > « Transaction pooler » (port 6543)
DATABASE_URL=postgres://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Au moins 32 caractères aléatoires (npm run admin:hash en génère un)
SESSION_SECRET=
ADMIN_EMAIL=
# Généré par : npm run admin:hash
ADMIN_PASSWORD_HASH=
# Sel des empreintes IP (chaîne aléatoire)
IP_HASH_SALT=
# Notifications e-mail (https://resend.com) — facultatif mais recommandé
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=Geometre Topo <notifications@exemple-domaine.cm>
